# =====================================================================
# Sales pipeline backend: environment variables
# Copy to .env and fill in. .env is gitignored; never commit real values.
# =====================================================================

# ---------- Django ----------
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True for local dev, False in production
DJANGO_DEBUG=True
# Comma-separated host names this server answers to
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The team's time zone: due dates, "today" and the digest hour follow it (keep it the same as the team's browsers)
DJANGO_TIME_ZONE=Asia/Kolkata

# ---------- Database (PostgreSQL 18 on this machine: port 5432) ----------
# The app connects as a NON-superuser role. Superusers bypass Row-Level
# Security, so never point this at the "postgres" user.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://sales_pipeline_app:CHANGE_ME@localhost:5432/sales_pipeline

# Only used once by `python manage.py bootstrap_db`, which creates the
# database and the app role above. This is your Postgres admin login.
POSTGRES_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres

# ---------- Redis / Celery (Redis runs in Docker: docker compose up -d) ----------
# Port 6380 so it can run next to the TipFlow project's Redis on 6379
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2
# Shared cache for rate limits and job locks. REQUIRED in production (every server process
# must count the same limits). Empty = in-memory, fine for local dev and tests only.
CACHE_URL=redis://localhost:6380/3
# Jobs that run longer are stopped (seconds): soft limit first, then hard
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_TIME_LIMIT=300

# ---------- Scheduled jobs (Celery Beat) ----------
# How often to check for stuck deals, nurture due dates and late payments
ALERT_CHECK_MINUTES=60
# Weekday morning digest time, in DJANGO_TIME_ZONE (e.g. Asia/Kolkata, America/Los_Angeles)
DIGEST_HOUR=8
DIGEST_MINUTE=0

# ---------- Auth (SimpleJWT) ----------
# Optional separate key for signing JWTs; empty = use DJANGO_SECRET_KEY
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ---------- CORS ----------
# Frontend origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# Gets stuck-deal and Tier A alerts together with the deal owner
GTM_LEAD_EMAIL=
# Used for links inside emails (deal links, staff invite links)
FRONTEND_URL=http://localhost:3000
# Staff invite links (set-password emails) expire after this many days
INVITE_DAYS=7

# ---------- Intake API (game, comparative analysis, audit tools) ----------
# Requests allowed per intake key, e.g. 120/min or 5000/day. Keys are created in Settings -> Integrations.
INTAKE_RATE=120/min
# ...and per key per day, so a leaked key can't flood the pipeline
INTAKE_DAILY_RATE=5000/day
# Requests per calling address, whatever key it sends (the tools' servers each have one address)
INTAKE_IP_RATE=600/min
# Wrong keys from one address per hour before that address is blocked for the hour
INTAKE_BAD_KEY_LIMIT=20
# Proxies in front of Django that append to X-Forwarded-For, so limits count the real caller.
# 1 for the Cloudflare tunnel (Next passes the header on unchanged) or one load balancer; unset only with no proxy.
DRF_NUM_PROXIES=1

# ---------- Rate limits: sign-in ----------
# Login and staff-invite pages, per address
AUTH_RATE=20/min
# Login attempts per email address, from anywhere (slows password guessing)
LOGIN_EMAIL_RATE=10/hour
TOKEN_REFRESH_RATE=60/min

# ---------- Logging ----------
# DEBUG, INFO, WARNING or ERROR. Logs go to stdout, one line each.
LOG_LEVEL=INFO
# Production only (DJANGO_DEBUG=False): redirect http to https. Set False if the proxy already does.
SECURE_SSL_REDIRECT=True

# ---------- Email (SMTP): all email ----------
# To leads (the booth form's game link) and to the team (alerts, daily digest, invites).
# Gmail / Google Workspace: an app password (Google account -> Security -> App passwords).
# Empty EMAIL_HOST = nothing is sent (emails are only logged); leads are still saved.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Sender names (same address): leads see EMAIL_FROM_NAME, the team sees STAFF_EMAIL_FROM_NAME
EMAIL_FROM_NAME=TourIQ
STAFF_EMAIL_FROM_NAME=TourIQ Pipeline
# Testing: every email (team and leads) goes to this one inbox instead, marked with who it was for.
# Empty = real recipients.
# Dummy addresses (example.com, *.test, ...) are never emailed.
EMAIL_REDIRECT_TO=
# The pricing game link (placeholder until the game is live; Settings -> Files and links overrides it)
GAME_LINK=https://touriq.ai/game

# Not used yet (reserved for reading replies)
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# ---------- AI (Claude API) ----------
# From https://console.anthropic.com. Empty = AI drafts are switched off.
ANTHROPIC_API_KEY=
AI_ENABLED=True
# Fast model: reply tagging, call summaries, next step, bulk fit scoring
AI_MODEL_FAST=claude-haiku-4-5
# Writing model: research briefs and outreach drafts
AI_MODEL_SMART=claude-sonnet-4-6
AI_TIMEOUT_SECONDS=45

# ---------- Google Calendar (demo and meeting events) ----------
# 1. Google Cloud console: create a service account, enable the Calendar API, download its JSON key.
# 2. Share the team calendar with the service account's email: "Make changes to events".
# Path to the key file, OR the key's JSON content (one line). Leave both empty to switch it off.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
# The calendar's ID (Calendar settings -> Integrate calendar), e.g. abc123@group.calendar.google.com
GOOGLE_CALENDAR_ID=
# Optional, Google Workspace only: with domain-wide delegation, act as this user so events invite
# the owner and the contact and get a Google Meet link. Empty = events on the calendar only.
GOOGLE_DELEGATED_USER=
CALENDAR_EVENT_MINUTES=30

# ---------- Recall.ai (recorded calls) ----------
# API key from the Recall dashboard (per region). Empty = recorded calls are switched off.
RECALL_API_KEY=
# The key's region: us-east-1, us-west-2, eu-central-1 or ap-northeast-1
RECALL_REGION=us-east-1
# Developers -> API Keys & Secrets -> Create Workspace Secret (starts with whsec_)
RECALL_WEBHOOK_SECRET=
RECALL_WEBHOOK_TOLERANCE_SECONDS=300

# ---------- Cloudflare R2 (business-card photos, step C) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public/custom domain for the bucket; empty = presigned URLs only
R2_PUBLIC_BASE_URL=

# ---------- Seed data (python manage.py seed_touriq) ----------
SEED_TENANT_NAME=TourIQ
# Login emails become <name>@SEED_EMAIL_DOMAIN, e.g. nikunj@touriq.ai
SEED_EMAIL_DOMAIN=touriq.ai
# First password for the seeded team users (change after first login)
SEED_DEFAULT_PASSWORD=
