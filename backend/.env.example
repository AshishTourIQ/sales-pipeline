# =====================================================================
# Sales pipeline backend: environment variables
# Copy to .env and fill in. .env is gitignored; never commit real values.
# =====================================================================

# ---------- Django ----------
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True for local dev, False in production
DJANGO_DEBUG=True
# Comma-separated host names this server answers to
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The team's time zone: due dates, "today" and the digest hour follow it (keep it the same as the team's browsers)
DJANGO_TIME_ZONE=Asia/Kolkata

# ---------- Database (PostgreSQL 18 on this machine: port 5432) ----------
# The app connects as a NON-superuser role. Superusers bypass Row-Level
# Security, so never point this at the "postgres" user.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://sales_pipeline_app:CHANGE_ME@localhost:5432/sales_pipeline

# Only used once by `python manage.py bootstrap_db`, which creates the
# database and the app role above. This is your Postgres admin login.
POSTGRES_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres

# ---------- Redis / Celery (Redis runs in Docker: docker compose up -d) ----------
# Port 6380 so it can run next to the TipFlow project's Redis on 6379
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# ---------- Scheduled jobs (Celery Beat) ----------
# How often to check for stuck deals, nurture due dates and late payments
ALERT_CHECK_MINUTES=60
# Weekday morning digest time, in DJANGO_TIME_ZONE (e.g. Asia/Kolkata, America/Los_Angeles)
DIGEST_HOUR=8
DIGEST_MINUTE=0

# ---------- Auth (SimpleJWT) ----------
# Optional separate key for signing JWTs; empty = use DJANGO_SECRET_KEY
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ---------- CORS ----------
# Frontend origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# ---------- Email (Resend) ----------
# From https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain verified in Resend. Use the product domain for
# internal alerts; cold outreach never goes through Resend.
EMAIL_FROM=TourIQ Pipeline <pipeline@example.com>
# Gets stuck-deal alerts together with the deal owner
GTM_LEAD_EMAIL=
# Used for links inside emails
FRONTEND_URL=http://localhost:3000

# ---------- AI (Claude API) ----------
# From https://console.anthropic.com. Empty = AI drafts are switched off.
ANTHROPIC_API_KEY=
AI_ENABLED=True
# Fast model: reply tagging, call summaries, next step, bulk fit scoring
AI_MODEL_FAST=claude-haiku-4-5
# Writing model: research briefs and outreach drafts
AI_MODEL_SMART=claude-sonnet-4-6
AI_TIMEOUT_SECONDS=45

# ---------- Cloudflare R2 (business-card photos, step C) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public/custom domain for the bucket; empty = presigned URLs only
R2_PUBLIC_BASE_URL=

# ---------- Seed data (python manage.py seed_touriq) ----------
SEED_TENANT_NAME=TourIQ
# Login emails become <name>@SEED_EMAIL_DOMAIN, e.g. nikunj@touriq.ai
SEED_EMAIL_DOMAIN=touriq.ai
# First password for the seeded team users (change after first login)
SEED_DEFAULT_PASSWORD=
