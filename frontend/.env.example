# =====================================================================
# Sales pipeline frontend: environment variables
# Copy to .env.local and fill in. .env* files are gitignored except this one.
#
# Only variables prefixed NEXT_PUBLIC_ reach the browser. Never put
# secrets (API keys, passwords) in a NEXT_PUBLIC_ variable. The frontend
# needs no secrets: all keys (Claude, Resend, R2) live in backend/.env.
# =====================================================================

# Django API base URL. Leave empty to run on the in-browser mock API.
NEXT_PUBLIC_SALES_PIPELINE_API=http://localhost:8010/api/sales-pipeline

# Auth endpoints (SimpleJWT) used by the standalone dev harness login.
# Inside the host app, the host's own auth replaces this.
NEXT_PUBLIC_AUTH_API=http://localhost:8010/api/auth
